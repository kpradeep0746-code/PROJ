<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ========== MAIN CONTENT ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

        <!-- TOP APP BAR -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background"
            android:elevation="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- NOA AI Text Logo (left) -->
            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Hamburger menu (right) -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_menu"
                android:padding="12dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_primary" />

        </androidx.appcompat.widget.Toolbar>

        <!-- Thin accent divider under toolbar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- SCROLLABLE WORKSPACE -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ── URL INPUT FIELD ── -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilYoutubeUrl"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:boxCornerRadiusBottomEnd="24dp"
                    app:boxCornerRadiusBottomStart="24dp"
                    app:boxCornerRadiusTopEnd="24dp"
                    app:boxCornerRadiusTopStart="24dp"
                    app:boxStrokeColor="@color/input_border"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/text_hint"
                    app:startIconDrawable="@android:drawable/ic_search_category_default"
                    app:startIconTint="@color/gradient_start">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etYoutubeUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_youtube_url"
                        android:imeOptions="actionDone"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ── YOUTUBE PLAYER CARD ── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardYouTubePlayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">

                    <!-- 16:9 Aspect Ratio container -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                            android:id="@+id/youTubePlayerView"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:autoPlay="false"
                            app:enableAutomaticInitialization="false"
                            app:layout_constraintDimensionRatio="16:9"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Error Overlay View -->
                        <LinearLayout
                            android:id="@+id/llPlayerErrorOverlay"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="20dp"
                            android:background="#202020"
                            android:visibility="gone"
                            app:layout_constraintDimensionRatio="16:9"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@android:drawable/ic_dialog_alert"
                                app:tint="#FFB347"
                                android:layout_marginBottom="8dp"
                                android:contentDescription="Error Warning" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Playback Restricted"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tvPlayerErrorOverlayMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="This video cannot be played inside the app because embedding is disabled."
                                android:textColor="#BDBDBD"
                                android:textSize="12sp"
                                android:gravity="center" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <!-- ── ACTION GRID LABEL ── -->
                <TextView
                    android:id="@+id/tvActionsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="AI Actions"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textAllCaps="true" />

                <!-- ── 2×2 ACTION BUTTON GRID ── -->
                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/gridActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:columnCount="2"
                    app:rowCount="2"
                    app:useDefaultMargins="false">

                    <!-- Row 1, Col 1 — Summarize -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSummarize"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_margin="6dp"
                        android:alpha="0.4"
                        android:enabled="false"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03"
                        android:text="@string/btn_summarize"
                        android:textColor="@color/on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@null"
                        android:background="@drawable/gradient_button"
                        app:cornerRadius="16dp"
                        app:layout_column="0"
                        app:layout_columnWeight="1"
                        app:layout_row="0" />

                    <!-- Row 1, Col 2 — Transcript -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTranscript"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_margin="6dp"
                        android:alpha="0.4"
                        android:enabled="false"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03"
                        android:text="@string/btn_transcript"
                        android:textColor="@color/on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@null"
                        android:background="@drawable/gradient_button"
                        app:cornerRadius="16dp"
                        app:layout_column="1"
                        app:layout_columnWeight="1"
                        app:layout_row="0" />

                    <!-- Row 2, Col 1 — Timestamps -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStudyPlan"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_margin="6dp"
                        android:alpha="0.4"
                        android:enabled="false"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03"
                        android:text="@string/chip_timestamps"
                        android:textColor="@color/on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@null"
                        android:background="@drawable/gradient_button"
                        app:cornerRadius="16dp"
                        app:layout_column="0"
                        app:layout_columnWeight="1"
                        app:layout_row="1" />

                    <!-- Row 2, Col 2 — Chat with AI -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBriefNotes"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_margin="6dp"
                        android:alpha="0.4"
                        android:enabled="false"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03"
                        android:text="Chat with AI"
                        android:textColor="@color/on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@null"
                        android:background="@drawable/gradient_button"
                        app:cornerRadius="16dp"
                        app:layout_column="1"
                        app:layout_columnWeight="1"
                        app:layout_row="1" />

                </androidx.gridlayout.widget.GridLayout>

                <!-- Bottom padding spacer -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- ========== NAVIGATION DRAWER ========== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/drawer_background"
        app:headerLayout="@layout/nav_header">

        <!-- RecyclerView for history inside drawer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="Recent Sessions"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

        </LinearLayout>

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
